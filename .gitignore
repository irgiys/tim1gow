node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.vite/
.turbo/
coverage/
.nyc_output/
*.tsbuildinfo
.eslintcache
.parcel-cache/

